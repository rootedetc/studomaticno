# Server port (usually set automatically by hosting platform)
PORT=3001

# Eduneta base URL (no need to change)
EDUNETA_BASE_URL=https://eduneta.hr

# Required for production
NODE_ENV=production

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional - only needed if frontend and backend are on different domains
# If using DigitalOcean App Platform with routing, leave unset
# FRONTEND_URL=https://your-frontend-url.com
